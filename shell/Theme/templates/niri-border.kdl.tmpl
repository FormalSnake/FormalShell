// Rendered by matugen (ThemeEngine) on every wallpaper/mode change; included
// from niri's own config.kdl. primary is the shared "active border" token,
// mutedForeground covers inactive windows, destructive covers attention
// requests.
layout {
    focus-ring {
        on
        width 2
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
    border {
        on
        width 2
        active-color "{{colors.primary.default.hex}}"
        inactive-color "{{colors.outline.default.hex}}"
        urgent-color "{{colors.error.default.hex}}"
    }
}

// FormalShell's shipped default menu tree (dotted-id hierarchy, per-key
// user-overridable at ~/.config/formalshell/menu.jsonc — see model.js's
// buildTree()). Kind is inferred per entry: `action` -> action, `target` ->
// link, `provider` -> submenu populated at tree-build time by providers.js
// (see "apps" below), else a plain submenu.
//
// Internal actions: an `action` value prefixed `@ipc:` is dispatched
// in-process instead of spawned via `sh -c` — Menu.qml's activation switches
// on the name after the prefix (e.g. "@ipc:theme.toggleMode" ->
// Core.State.toggleMode()). Use this for anything that must run in the
// shell's own process rather than as a detached command.
{
    "apps": { "provider": "apps", "icon": "󰀻" },
    "clipboard": { "provider": "clipboard", "icon": "󰅍" },
    // "calc" registers no provider fn — the node exists as a summonable
    // route (`menu summon calc`) whose level Menu.qml special-cases to show
    // only the live CALC result row for the typed expression (calc.js).
    "calc": { "label": "Calculator", "provider": "calc", "icon": "󰃬" },
    // "emoji" registers no provider fn either: a summonable route
    // (`menu summon emoji`) whose level Menu.qml points at the vendored
    // emoji dataset (emoji.json) instead of the tree; ":e <query>" reaches
    // the same rows from anywhere.
    "emoji": { "label": "Emoji", "provider": "emoji", "icon": "" },
    // "nix" registers no provider fn either: a summonable route
    // (`menu summon nix`) whose level Menu.qml fills from the debounced
    // `nix search nixpkgs` cache; ":nix <query>" reaches the same rows
    // from anywhere. No nix on PATH renders a single dim NO NIX row.
    "nix": { "label": "Nix Run", "provider": "nix", "icon": "" },

    "system": { "label": "System", "icon": "󰒓" },
    "system.lock": { "action": "qs ipc call lock lock", "when": "false" },
    "system.suspend": { "action": "systemctl suspend", "icon": "󰤄" },
    "system.reboot": { "action": "systemctl reboot", "icon": "󰜉", "confirm": true },
    "system.shutdown": { "action": "systemctl poweroff", "icon": "󰤂", "confirm": true },
    "system.logout": {
        "action": "niri msg action quit --skip-confirmation",
        "icon": "󰍃",
        "when": "test -n \"$NIRI_SOCKET\""
    },
    "system.notifications": {
        "label": "Notifications",
        "action": "@ipc:notifications.showHistory",
        "icon": "󰂚"
    },

    "theme": { "label": "Theme", "icon": "󰏘" },
    "theme.mode-toggle": { "label": "Toggle Mode", "action": "@ipc:theme.toggleMode", "icon": "󰔎" },

    // SHARE (M17 Task 1): present only when `localsend_app` resolves on
    // PATH (nixpkgs' pkgs.localsend package, verified against its actual
    // installed bin/ — not the bare `localsend` name omarchy assumes) — the
    // standard `command -v` presence guard (see TailscalePanel.qml's own
    // "NO TAILSCALE" check for the same idiom). "share.clipboard" is a
    // placeholder: providers.js's shareClipboardEntry() overwrites it at
    // tree-build time with the live newest-clipboard-entry action (or the
    // honest NOTHING TO SHARE row), keeping its declared position ahead of
    // "share.history"/"share.receive" below.
    "share": { "label": "Share", "icon": "󰒗", "when": "command -v localsend_app >/dev/null 2>&1" },
    "share.clipboard": { "label": "Clipboard" },
    "share.history": { "label": "Pick From History", "provider": "shareHistory", "icon": "󰋚" },
    "share.receive": { "label": "Receive", "action": "localsend_app", "icon": "󰥦" }

    // The root "wallpaper" node (opens the image picker grid) is injected at
    // tree-build time by Menu.qml via providers.js's wallpaperEntry(): its
    // action targets the running shell's own path, which static jsonc can't
    // know. Override or hide it from menu.jsonc by its "wallpaper" id like
    // any declared node.
}

post_install() {
  cat <<'MSG'
==> Start FormalShell with your Hyprland session:
      systemctl --user enable formalshell.service formalshell-watchdog.timer
==> USB-C and CPU draw in the power panel:
      systemctl enable --now formalshell-power-poll.service
==> Binds and layer rules, one line in ~/.config/hypr/hyprland.lua:
      dofile("/usr/share/formalshell/examples/hyprland/formalshell.lua")
MSG
}

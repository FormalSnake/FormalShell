# Maintainer: FormalSnake <https://github.com/FormalSnake>
#
# The shell plus the tools nix/ builds itself, at the versions nix/ pins, as
# split packages. ttfx and tensaku have AUR packages, but at other versions
# (0.5.0 and 0.29.0 against 0.4.0 and 0.26.6), so they are built here under a
# formalshell- name and provide the upstream one. The first checksum is the
# tag tarball's: build.sh fills it in, from GitHub for a tag or from the
# working tree for a local build.

pkgbase=formalshell
pkgname=(
  formalshell
  formalshell-eds
  formalshell-ttfx
  formalshell-tensaku
  formalshell-clipssh
  formalshell-localsend-cli
  formalshell-iphone-bridge
  formalshell-ancs4linux
)
pkgver=0.1.0
pkgrel=1
pkgdesc='Hyprland desktop shell built on Quickshell'
arch=('x86_64' 'aarch64')
url='https://github.com/FormalSnake/FormalShell'
license=('MIT')
makedepends=(
  cargo
  gtk4
  gtk4-layer-shell
  go
  libadwaita
  libepoxy
  nasm
  python
  python-build
  python-hatchling
  python-installer
  qt6-shadertools
  systemd
  zig
)
options=('!lto')

_lucidever=1.34.0
_ttfxver=0.4.0
_tensakuver=0.26.6
_clipssh=c7f4e8ddcf102302c6375ba51534c7505ddc2616
_localsend=7865fb1cf26e4f782c6400167a7d218d69313cff
_iphone=586f37dce6aceef72376afb8be8bcc8a04de41fe
_ancs=b658546f08d1468f6d79aa900cc7faa9d938837d

source=(
  "FormalShell-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz"
  "lucide-font-$_lucidever.zip::https://github.com/lucide-icons/lucide/releases/download/$_lucidever/lucide-font-$_lucidever.zip"
  "ttfx-$_ttfxver.tar.gz::https://github.com/omacom/ttfx/archive/refs/tags/v$_ttfxver.tar.gz"
  "tensaku-$_tensakuver.tar.gz::https://github.com/jondkinney/tensaku/archive/refs/tags/v$_tensakuver.tar.gz"
  "clipssh-$_clipssh.tar.gz::https://github.com/samuellawrentz/clipssh/archive/$_clipssh.tar.gz"
  "localsend-cli-$_localsend.tar.gz::https://github.com/0w0mewo/localsend-cli/archive/$_localsend.tar.gz"
  "omarchy-iphone-$_iphone.tar.gz::https://github.com/kbbahaPro/omarchy-iphone/archive/$_iphone.tar.gz"
  "ancs4linux-$_ancs.tar.gz::https://github.com/pzmarzly/ancs4linux/archive/$_ancs.tar.gz"
)
sha256sums=('SKIP'
            '1606dba9b2abe06168ee818bea7e66e3c5b881b56ee73e6331cee1cb4e096756'
            '90a057971973917a45ae1cb2fc795cfaea33afc265180ba4a963172daf9f64ee'

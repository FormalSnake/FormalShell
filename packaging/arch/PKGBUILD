prepare() {
  local fs="$srcdir/FormalShell-$pkgver"
  export RUSTUP_TOOLCHAIN=stable

  cd "$fs/crates"
  cargo fetch --locked --target "$(rustc --print host-tuple)"

  cd "$srcdir/ttfx-$_ttfxver"
  cargo fetch --locked --target "$(rustc --print host-tuple)"

  cd "$srcdir/tensaku-$_tensakuver"
  rm -f rust-toolchain.toml
  cargo fetch --locked --target "$(rustc --print host-tuple)"

  local crate
  for crate in nothingctl-$_nothingctlver OpenSCQ30-$_openscq30ver LiveBudsCli-$_earbudsver; do
    cd "$srcdir/$crate"
    cargo fetch --locked --target "$(rustc --print host-tuple)"
  done

  # Same fix as nix/localsend-cli.nix: without a Content-Type every send is
  # rejected by a fiber receiver, this CLI's own `recv` included.
  export GOPATH="$srcdir/gopath" GOFLAGS=-modcacherw
  cd "$srcdir/localsend-cli-$_localsend"
  sed -i 's/req.SetBodyRaw(metaJson)/req.Header.SetContentType("application\/json"); req.SetBodyRaw(metaJson)/' \
    internal/localsend/send/fwdsend.go
  grep -q 'SetContentType("application/json")' internal/localsend/send/fwdsend.go
  go mod download

  cd "$srcdir/omarchy-iphone-$_iphone"
  patch -Np1 -i "$fs/nix/iphone-ams-subscribe.patch"
  patch -Np1 -i "$fs/nix/iphone-bridge-bond.patch"

  cd "$srcdir/ancs4linux-$_ancs"
  patch -Np1 -i "$srcdir/omarchy-iphone-$_iphone/patches/ancs4linux-metadata.patch"
  patch -Np1 -i "$fs/nix/ancs4linux-authorize.patch"
}

build() {
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target

  make -C "$srcdir/FormalShell-$pkgver/packaging"

  cd "$srcdir/FormalShell-$pkgver/tools/eds"
  zig build --global-cache-dir "$srcdir/zig-cache" --release=safe -Dcpu=baseline --prefix "$srcdir/eds"

  # The x86-64 engine's asm objects call libc with PC32 relocations, which a
  # PIE link rejects (nix/ttfx-package.nix). An explicit --target keeps the
  # static model off the proc-macros, which have to stay shared objects.
  cd "$srcdir/ttfx-$_ttfxver"
  RUSTFLAGS="$RUSTFLAGS -C relocation-model=static" \
    cargo build --frozen --release --target "$(rustc --print host-tuple)"

  cd "$srcdir/tensaku-$_tensakuver"
  cargo build --frozen --release --features ci-release

  cd "$srcdir/nothingctl-$_nothingctlver"
  cargo build --frozen --release

  cd "$srcdir/OpenSCQ30-$_openscq30ver"
  cargo build --frozen --release --package openscq30-cli

  cd "$srcdir/LiveBudsCli-$_earbudsver"
  cargo build --frozen --release

  cd "$srcdir/localsend-cli-$_localsend"
  export GOPATH="$srcdir/gopath"
  export CGO_CPPFLAGS="$CPPFLAGS" CGO_CFLAGS="$CFLAGS" CGO_CXXFLAGS="$CXXFLAGS" CGO_LDFLAGS="$LDFLAGS"
  export GOFLAGS="-buildmode=pie -trimpath -ldflags=-linkmode=external -mod=readonly -modcacherw"
  go build -buildvcs=false -o localsend-cli .

  cd "$srcdir/ancs4linux-$_ancs"
  python -m build --wheel --no-isolation
}

package_formalshell() {
  pkgdesc='Hyprland desktop shell'
  # Everything nix/package.nix puts on the wrapper's PATH that a caller runs
  # without a `command -v` guard, plus the daemons the network, audio,
  # battery and polkit surfaces have no other backend for, and the libraries
  # the binary links.
  depends=(
    fontconfig
    gcc-libs
    glibc
    libxkbcommon
    pam
    noto-fonts-emoji
    ttf-nerd-fonts-symbols
    brightnessctl
    coreutils
    curl
    ddcutil
    ffmpeg
    formalshell-eds
    formalshell-iphone-bridge
    formalshell-tensaku
    glib2
    grim
    libpulse
    matugen
    mpv
    networkmanager
    openssh
    pipewire
    polkit
    procps-ng
    slurp
    systemd
    tesseract
    tesseract-data-eng
    upower
    util-linux
    wf-recorder
    wireplumber
    wl-clipboard
    wlsunset
    xdg-utils
  )
  optdepends=(
    'asusctl: keyboard lights'
    'bluez: bluetooth panel'
    'bluez-utils: bluetooth panel device actions'
    'cava: audio visualizer'
    'evolution-data-server: calendar events'
    'formalshell-ancs4linux: iPhone notifications and now playing'
    'formalshell-clipssh: send clipboard images over ssh'
    'formalshell-earbuds: Samsung Galaxy Buds in the earbuds panel'
    'formalshell-localsend-cli: LocalSend sharing'
    'formalshell-nothingctl: Nothing and CMF headsets in the earbuds panel'
    'formalshell-openscq30: Soundcore earbuds in the earbuds panel'
    'formalshell-ttfx: animated screensaver banner'
    'geoclue: location without a network lookup'
    'git: flake input update checks'
    'power-profiles-daemon: power profile picker'
    'qrencode: Wi-Fi QR share'
    'uxplay: AirPlay receiver (AUR)'
    'wtype: emoji paste and polkit autofill'
  )
  backup=(
    etc/pam.d/formalshell-lock
    etc/geoclue/conf.d/formalshell.conf
  )
  install=formalshell.install

  cd "$srcdir/FormalShell-$pkgver"
  make -C packaging install DESTDIR="$pkgdir" PREFIX=/usr PAM=arch \
    LUCIDE_TTF="$srcdir/lucide-font/lucide.ttf"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_formalshell-eds() {
  pkgdesc='Evolution Data Server calendar companion CLI for FormalShell'
  depends=(glibc systemd-libs)

  install -Dm755 "$srcdir/eds/bin/formalshell-eds" "$pkgdir/usr/bin/formalshell-eds"
  install -Dm644 "$srcdir/FormalShell-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}


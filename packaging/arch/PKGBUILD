package_formalshell-iphone-bridge() {
  pkgdesc='JSONL bridges over ancs4linux ANCS and AMS D-Bus signals'
  url='https://github.com/kbbahaPro/omarchy-iphone'
  arch=('any')
  depends=(glib2 python python-gobject)

  cd "$srcdir/omarchy-iphone-$_iphone"
  install -Dm755 bin/omarchy-iphone-bridge "$pkgdir/usr/bin/omarchy-iphone-bridge"
  install -Dm755 bin/omarchy-iphone-ams "$pkgdir/usr/bin/omarchy-iphone-ams"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}

package_formalshell-ancs4linux() {
  pkgdesc='ANCS and AMS bridge exposing an iPhone as system D-Bus services'
  url='https://github.com/pzmarzly/ancs4linux'
  arch=('any')
  license=('GPL-2.0-or-later')
  depends=(bluez python python-dasbus python-gobject python-typer)
  provides=(ancs4linux)
  conflicts=(ancs4linux)
  install=formalshell-ancs4linux.install

  cd "$srcdir/ancs4linux-$_ancs"
  python -m installer --destdir="$pkgdir" dist/*.whl
  local unit
  for unit in observer advertising; do
    sed 's|/usr/local/bin/|/usr/bin/|' autorun/ancs4linux-$unit.service \
      | install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/ancs4linux-$unit.service"
    install -Dm644 autorun/ancs4linux-$unit.xml "$pkgdir/usr/share/dbus-1/system.d/ancs4linux-$unit.conf"
  done
  echo 'g ancs4linux - -' | install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/ancs4linux.conf"
  install -Dm644 LICENSE.txt "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}


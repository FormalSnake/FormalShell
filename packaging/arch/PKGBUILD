# Maintainer: FormalSnake <https://github.com/FormalSnake>
#
# The shell plus the tools nix/ builds itself, at the versions nix/ pins, as
# split packages. ttfx, tensaku, openscq30-cli and earbuds have AUR packages,
# but at other versions (0.5.0, 0.29.0, 2.11.0 and 0.1.9 against 0.4.0,
# 0.26.6, 2.12.0 and 0.2.0), so they are built here under a formalshell- name
# and provide the upstream one. The first checksum is the
# tag tarball's: build.sh fills it in, from GitHub for a tag or from the
# working tree for a local build.

pkgbase=formalshell
pkgname=(
  formalshell
  formalshell-eds
  formalshell-ttfx
  formalshell-tensaku
  formalshell-clipssh
  formalshell-localsend-cli
  formalshell-iphone-bridge
  formalshell-ancs4linux
  formalshell-nothingctl
  formalshell-openscq30
  formalshell-earbuds
)
pkgver=0.1.1
pkgrel=1
pkgdesc='Hyprland desktop shell'
arch=('x86_64' 'aarch64')
url='https://github.com/FormalSnake/FormalShell'
license=('MIT')
makedepends=(
  bluez-libs
  cargo
  clang

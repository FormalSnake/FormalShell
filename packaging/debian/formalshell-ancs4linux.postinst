#!/bin/sh
set -e

if [ "$1" = configure ] && [ -z "$2" ]; then
	cat <<'MSG'
ancs4linux: for iPhone notifications, join the ancs4linux group and start the daemons:
    usermod -aG ancs4linux <user>
    systemctl enable --now ancs4linux-observer.service ancs4linux-advertising.service
MSG
fi

#DEBHELPER#
